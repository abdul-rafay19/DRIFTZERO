# IBM Bob — sole AI provider (Phase 2)
# Create an Inference key at https://bob.ibm.com (Settings > API Keys)
# Inference key: no extra headers needed
# General key:   requires BOB_TEAM_ID and BOB_INSTANCE_ID
BOB_API_KEY=
# Required only when using a General (non-Inference) API key:
BOB_TEAM_ID=
BOB_INSTANCE_ID=

# Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Future GitHub integration (Phase 3+)
GITHUB_TOKEN=
